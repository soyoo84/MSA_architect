# 분석할 로컬 소스 코드 경로 (SVN 체크아웃 폴더)
SOURCE_DIRECTORY=./monolith_source

# 데이터베이스 스키마(DDL) 자동 추출을 위한 DB 접속 URL (필수 아님, DB 직접 연결 시 사용)
# 오라클 예시 (서비스명 접속): oracle+oracledb://사용자명:비밀번호@주소:포트/?service_name=서비스명
# 오라클 예시 (SID 접속): oracle+oracledb://사용자명:비밀번호@주소:포트/SID
DB_URL=oracle+oracledb://admin:1234@192.168.0.10:1521/?service_name=orcl

# 사내 LLM (Qwen 3.5) API 설정
LLM_BASE_URL=http://your-internal-llm-server/v1
LLM_API_KEY=your_internal_llm_api_key
LLM_MODEL_NAME=qwen3.5

# [성능 튜닝 가이드]
# LLM 서버에 가해지는 순간 최대 동시 요청 수는 'LLM_MAX_WORKERS * ASYNC_CHUNK_CONCURRENCY' 입니다.
# 서버에서 VRAM OOM(메모리 부족) 에러나 502/503 에러가 잦다면 아래 수치들을 조절해 주세요.

# 병렬 처리 워커 수 (동시 API 요청 수)
# OOM 발생 시 가장 먼저 2~3개로 대폭 줄여서 서버 부하를 낮춰보세요.
LLM_MAX_WORKERS=5

# 개별 워커 타임아웃 (초 단위, 무한 대기 방지)
# 워커 수와 동시성을 줄이면 대기 시간이 길어져 타임아웃이 날 수 있습니다. OOM 방지 세팅 시 600초(10분) 정도로 늘려주세요.
WORKER_TIMEOUT_SECONDS=300

# 파일 분할(Chunking) 비동기 처리 시 동시 요청 제한 수
# 대용량 파일 분할 시, 1개 파일 내에서 동시에 보낼 API 요청 수입니다. (OOM 발생 시 1 또는 2로 하향 조정)
ASYNC_CHUNK_CONCURRENCY=3

# 대용량 DDL(.sql) 파일 전용 비동기 처리 동시 요청 제한 수 (VRAM 보호를 위해 기본 1 권장)
ASYNC_CHUNK_CONCURRENCY_SQL=1

# 분석에서 제외할 패키지 또는 디렉토리 경로 (쉼표로 구분)
EXCLUDE_PATHS=com/example/common,src/test